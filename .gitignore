# Portable Node, Playwright CLI and their sandboxes (large binaries, machine-specific)
.tools/
.playwright/
.playwright-cli/

# Dependencies and build output
node_modules/
.next/
out/
.vercel/

# Local-only files
*.log
.env*
.claude/settings.local.json

# Original photos stay local: they carry GPS location, timestamps and phone model in EXIF.
# The site uses metadata-free copies in wanderlust-journeys/public/images.
Images/*
!Images/website_prototype_image.jpg
